# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tu_base
DB_USER=tu_usuario
DB_PASS=tu_password

# JWT
# Clave activa para firmar tokens
JWT_SECRET_KEY=cambiar_por_clave_larga_y_aleatoria
# Clave previa opcional para validar tokens durante rotacion
JWT_PREVIOUS_SECRET_KEY=
# Dias de validez para refresh token
REFRESH_TOKEN_DAYS=14
MAX_UPLOAD_IMAGE_BYTES=5242880

# Web Push (VAPID)
VAPID_SUBJECT=mailto:admin@tudominio.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# CORS (origenes permitidos, separados por coma)
# Ejemplo: https://app.tudominio.com,https://admin.tudominio.com
CORS_ALLOWED_ORIGINS=

